{
  "name": "flagora",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter @flagora/shared build && pnpm --filter @flagora/server build",
    "build:web": "pnpm --filter @flagora/shared build && pnpm --filter @flagora/web build",
    "start": "pnpm --filter @flagora/server start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "load:gameplay": "k6 run load-tests/gameplay-loop.js",
    "load:leaderboards": "k6 run load-tests/leaderboards.js",
    "load:rewards": "k6 run load-tests/reward-flow.js",
    "load:battles": "k6 run load-tests/battles.js",
    "test:load-smoke": "pnpm --filter @flagora/server exec tsx --test ../../load-tests/smoke.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  }
}
