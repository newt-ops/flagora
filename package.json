{
  "name": "flagora",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter @flagora/shared build && pnpm --filter @flagora/server build",
    "build:web": "pnpm --filter @flagora/shared build && pnpm --filter @flagora/web build",
    "start": "pnpm --filter @flagora/server start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  }
}
